{
  "name": "ciouciou",
  "version": "1.1.0",
  "description": "Tray + floating island monitor for a homelab running Ollama, Open WebUI and n8n",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "status": "node src/cli.js --once",
    "watch": "node src/cli.js",
    "prebuild": "node scripts/make-preset.js && node scripts/make-icon.js",
    "build": "electron-builder --win nsis"
  },
  "author": "Sacha Guerin",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "productName": "ciouciou",
  "build": {
    "appId": "fr.sachaguerin.ciouciou",
    "productName": "ciouciou",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "config.example.json",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ciouciou",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
